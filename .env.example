# Lokal ishga tushirish uchun .env fayli allaqachon tayyor holda mavjud —
# bu fayl faqat production'ga chiqarganda namuna sifatida ishlatiladi.

# Database (production — PostgreSQL, masalan Neon yoki Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/imtihonai"

# Lokal development uchun (SQLite, hozirgi .env shu bilan ishlaydi):
# DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
